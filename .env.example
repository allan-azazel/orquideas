# Copia este archivo como ".env" y completa los datos.

# --- Aplicación ---
PORT=3000
ZONA_HORARIA=America/Santiago

# --- Base de datos (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=orquideas_monitor

# --- Modo prueba ---
# true  = NO envía nada real; registra la notificación como "Simulada".
# false = envía correos y WhatsApp de verdad (requiere completar lo de abajo).
MODO_PRUEBA=true

# --- Correo (SMTP) ---
# Ejemplo con Gmail: activar verificación en 2 pasos y crear una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=contraseña_de_aplicacion
SMTP_FROM="Monitor de Orquídeas <tucorreo@gmail.com>"

# --- WhatsApp (servicio gratuito CallMeBot, https://www.callmebot.com/blog/free-api-whatsapp-messages/) ---
# Cada número debe activarse una vez en CallMeBot; ellos te entregan la apikey.
CALLMEBOT_APIKEY=
